<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Ночная сборка книги «Фин рез» кабинета РБХ-1 (дополнение 23.10 п. 3): после KARATOV (06:00 МСК), ночь Render кабинета кончается ~04:xx МСК.
         Код — worktree ветки multi-cabinet (~/mp-analytics-rbh; venv — ссылка на основной), профиль — MP_CABINET=rbh1 (.env.rbh1 поверх .env).
         Установка: cp ops/launchd/com.mp-analytics.rbh1.finrez-nightly.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.mp-analytics.rbh1.finrez-nightly.plist
         Снять: launchctl bootout gui/$(id -u)/com.mp-analytics.rbh1.finrez-nightly. Копия владельцу — FINREZ_COPY_DIR/rbh1/ (ответ 23.10, п. 3). -->
    <key>Label</key>
    <string>com.mp-analytics.rbh1.finrez-nightly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/mihaileliseev/mp-analytics-rbh/scripts/finrez_nightly.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/mihaileliseev/mp-analytics-rbh</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MP_CABINET</key>
        <string>rbh1</string>
        <!-- копия владельцу (ответ советника 23.10, п. 3): та же папка iCloud «Фин рез», что у KARATOV; finrez_nightly.sh кладёт книгу
             кабинета в подпапку rbh1/ (создаёт её сама); папки нет — шаг копии даёт ошибку в итоге, книга при этом собрана -->
        <key>FINREZ_COPY_DIR</key>
        <string>/Users/mihaileliseev/Library/Mobile Documents/com~apple~CloudDocs/Фин рез</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>ru_RU.UTF-8</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/mihaileliseev/mp-analytics-rbh/logs/rbh1/finrez_nightly/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mihaileliseev/mp-analytics-rbh/logs/rbh1/finrez_nightly/launchd.err.log</string>
</dict>
</plist>
